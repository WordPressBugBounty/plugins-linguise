{
  "name": "linguise-script-php",
  "version": "1.0.0",
  "description": "Linguise accompaniment script-php data",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently \"yarn dev:admin\" \"yarn dev:login\"",
    "dev:admin": "vite build --watch --mode development -c vite.config.admin.mjs",
    "dev:login": "vite build --watch --mode development -c vite.config.login.mjs",
    "build": "yarn build:admin && yarn build:login",
    "build:admin": "vite build -c vite.config.admin.mjs",
    "build:login": "vite build -c vite.config.login.mjs"
  },
  "author": "Linguise",
  "license": "Proprietary",
  "dependencies": {
    "codemirror": "^5.61.0",
    "rangeslider-js": "^3.2.5",
    "script-js": "git+ssh://git@bitbucket.org/linguise/script-js.git",
    "tippy.js": "^6.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.1",
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.12.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "material-design-icons": "^3.0.1",
    "sass": "^1.98.0",
    "url-polyfill": "^1.1.12",
    "vite": "^8.0.16"
  },
  "resolutions": {
    "@aws-sdk/types": "3.965.0",
    "@aws-sdk/util-locate-window": "3.965.0"
  },
  "volta": {
    "node": "24.14.1",
    "yarn": "4.17.0"
  },
  "packageManager": "yarn@4.17.0"
}
